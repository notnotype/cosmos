# Dependencies and build output
node_modules/
.nuxt/
.output/
dist/
coverage/
playwright-report/
test-results/
.worktree/
.worktrees/

# Local runtime data
.cosmos/
.agent/
.zcode/
/.local/*
!/.local/README.md
var/
cache/
.archify/
# Agent 工具的本地会话状态（临时面板 HTML、PID、日志），不是项目产物。
.superpowers/
# 人工评审时的全文草稿，单个文件可达 160 KB，超出单文件规模红线。
**/notes-review*.txt
*.restored
# 编辑工具留下的操作锁，不是项目文件（不要用 *.lock，会误伤 bun.lock）。
.dsh-ops-update-*.lock

# Secrets and local configuration
.env
.env.*
!.env.example
config.local.*

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
