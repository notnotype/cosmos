{
    "name": "cosmos",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A local-first, composable information aggregation and personal intelligence workspace.",
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*",
        "plugins/*"
    ],
    "scripts": {
        "dev": "bun run scripts/dev.ts",
        "dev:web": "bun run --cwd apps/web dev",
        "dev:api": "bun run scripts/dev-service.ts api",
        "dev:worker": "bun run scripts/dev-service.ts worker",
        "build:packages": "bun run build:contracts && bun run build:logging && bun run build:domain && bun run build:application && bun run build:storage && bun run build:blob-store && bun run build:worker-admin && bun run build:rss && bun run build:collectors && bun run build:transport",
        "build:contracts": "bun run --cwd packages/contracts build",
        "build:logging": "bun run --cwd packages/logging build",
        "build:domain": "bun run --cwd packages/domain build",
        "build:application": "bun run --cwd packages/application build",
        "build:storage": "bun run --cwd packages/storage-prisma build",
        "build:blob-store": "bun run --cwd packages/blob-store build",
        "build:worker-admin": "bun run --cwd packages/worker-admin build",
        "build:rss": "bun run --cwd plugins/rss build",
        "build:collectors": "bun run --cwd plugins/collectors build",
        "build:transport": "bun run --cwd packages/transport-http build",
        "build:api": "bun run build:packages && bun run --cwd apps/api build",
        "build:worker": "bun run --cwd apps/worker build",
        "build:web": "bun run --cwd apps/web build",
        "build": "bun run build:api && bun run build:worker && bun run build:web",
        "typecheck:packages": "bun run typecheck:contracts && bun run typecheck:logging && bun run typecheck:domain && bun run typecheck:application && bun run typecheck:storage && bun run typecheck:blob-store && bun run typecheck:worker-admin && bun run typecheck:rss && bun run typecheck:collectors && bun run typecheck:transport",
        "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
        "typecheck:logging": "bun run --cwd packages/logging typecheck",
        "typecheck:domain": "bun run --cwd packages/domain typecheck",
        "typecheck:application": "bun run --cwd packages/application typecheck",
        "typecheck:storage": "bun run --cwd packages/storage-prisma typecheck",
        "typecheck:blob-store": "bun run --cwd packages/blob-store typecheck",
        "typecheck:worker-admin": "bun run --cwd packages/worker-admin typecheck",
        "typecheck:rss": "bun run --cwd plugins/rss typecheck",
        "typecheck:collectors": "bun run --cwd plugins/collectors typecheck",
        "typecheck:transport": "bun run --cwd packages/transport-http typecheck",
        "typecheck:apps": "bun run --cwd apps/api typecheck && bun run --cwd apps/worker typecheck && bun run --cwd apps/web tsc --noEmit",
        "typecheck": "bun run typecheck:packages && bun run typecheck:apps",
        "lint:web": "bun run --cwd apps/web lint",
        "docs:check": "bun run scripts/check-documentation.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:property": "vitest run --config vitest.property.config.ts",
        "test:e2e": "bun run build:api && bun run build:worker && vitest run --config vitest.e2e.config.ts",
        "test:browser": "bun run build && playwright test --config playwright.config.ts",
        "test:browser:component-lab": "playwright test --config playwright.component-lab.config.ts",
        "test:docker": "bun run scripts/e2e/docker-flow.ts",
        "test:real:rss": "bun run scripts/e2e/real-source.ts rss",
        "test:real:aihot": "bun run scripts/e2e/real-source.ts aihot",
        "test:real:bilibili": "bun run scripts/e2e/real-source.ts bilibili",
        "db:validate": "bun run scripts/prisma.ts validate",
        "db:generate": "bun run scripts/prisma.ts generate",
        "db:migrate": "bun run scripts/prisma.ts migrate deploy",
        "db:migrate:dev": "bun run scripts/prisma.ts migrate dev",
        "db:status": "bun run scripts/prisma.ts migrate status"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@prisma/client": "6.19.3",
        "@types/node": "^24.0.0",
        "fast-check": "^4.9.0",
        "tsx": "^4.20.3",
        "typescript": "^5.0.0",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@notnotype/nb-workflow": "0.2.0"
    }
}
